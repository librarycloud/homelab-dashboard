# Copy this file to .env before starting the Node API.
ADMIN_USERNAME=admin
# Format: salt:hex_scrypt_hash. Do not commit a real .env file.
ADMIN_PASSWORD_HASH=replace_me
SESSION_SECRET=replace_with_a_long_random_value
API_PORT=3000

# MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=homelab_dashboard
DB_USER=homelab
DB_PASSWORD=change_this_password
DB_CONNECTION_LIMIT=5
